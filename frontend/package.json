{
  "name": "ganadoconecta-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:pwa": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reportsDirectory coverage/vitest --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=lcov",
    "test:jest": "jest --runInBand",
    "test:jest:coverage": "jest --runInBand --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "jest": "30.5.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.1.0"
  }
}

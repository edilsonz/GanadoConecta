# Copiar a .env (ignorado), solo para desarrollo local.
# Elegir usuario y contraseña locales; nunca compartir valores reales.
POSTGRES_DB=ganadoconecta
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
DB_HOST=127.0.0.1
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Rutas absolutas a claves RSA externas. Pública X.509 y privada PKCS#8 en PEM.
GANADOCONECTA_JWT_PUBLIC_KEY_PATH=
GANADOCONECTA_JWT_PRIVATE_KEY_PATH=
GANADOCONECTA_JWT_ISSUER=ganadoconecta-api
GANADOCONECTA_JWT_AUDIENCE=ganadoconecta-web
# Solo usado por el proxy de Vite, no se publica en el bundle.
API_PROXY_TARGET=http://127.0.0.1:8080
